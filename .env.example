# ============================================================
# content-autopilot-v2 — Umgebungsvariablen
# Kopieren: cp .env.example .env  dann Secrets eintragen
# ============================================================

# === Datenbank ===
DB_PASSWORD=changeme                    # PostgreSQL-Passwort für User 'autopilot'
DATABASE_URL=postgresql+asyncpg://autopilot:${DB_PASSWORD}@host.docker.internal:5432/content_autopilot_v2
SYNC_DATABASE_URL=postgresql://autopilot:${DB_PASSWORD}@host.docker.internal:5432/content_autopilot_v2

# === Redis ===
REDIS_URL=redis://redis-v2:6379/1       # Intern im Docker-Netz

# === LLM-Provider (mindestens einen ausfüllen) ===
GEMINI_API_KEY=                         # Google Gemini Direct API (optional wenn LiteLLM aktiv)
ANTHROPIC_API_KEY=                      # Anthropic Claude Direct API (optional wenn LiteLLM aktiv)
LITELLM_BASE_URL=                       # LiteLLM Proxy oder Requesty.ai Router-URL
LITELLM_API_KEY=                        # API-Key für LiteLLM / Requesty.ai
REQUESTY_API_KEY=                       # Direkter Requesty.ai Key (alternativ zu LITELLM_API_KEY)

# === Nextcloud (Brand Voice + Prompts) ===
NEXTCLOUD_URL=https://nc.example.com    # Nextcloud-Instanz
NEXTCLOUD_USER=service-user             # Nextcloud-Benutzername
NEXTCLOUD_PASSWORD=app-password-here    # Nextcloud App-Passwort (nicht Login-PW)

# === Storage-Pfade (Nextcloud) ===
BRAND_VOICE_NC_BASE_PATH=/content-autopilot/v2/Kunde/
PROMPT_NC_BASE_PATH=/zukunftsbund/projekte/content-autopilot/datensammlung/prompts-skills/

# === Tenant ===
DEFAULT_TENANT_KEY=cap-tenant-changeme  # API-Key für den Default-Tenant (X-API-Key Header)

# === Ports ===
APP_PORT=8601                           # Frontend + API Port (nginx)
MCP_PORT=8180                           # MCP-Server Port (extern)

# === App ===
APP_ENV=production                      # dev | staging | production

# === MCP-Server (OAuth / Bearer) ===
MCP_CLIENT_ID=content-autopilot         # OAuth 2.0 Client-ID für claude.ai Connector
MCP_CLIENT_SECRET=                      # OAuth 2.0 Client-Secret (optional)
MCP_BEARER_TOKEN=                       # Bearer Token für MCP-Zugriff

# === Error-Tracking (optional) ===
SENTRY_DSN=                             # Sentry DSN — leer lassen für disabled

# === Telegram (optional, Phase 3) ===
TELEGRAM_BOT_TOKEN=                     # Telegram Bot-Token
TELEGRAM_WEBHOOK_SECRET=               # Telegram Webhook Secret
TELEGRAM_BOT_USERNAME=content_autopilot_bot

# === Intern (normalerweise nicht ändern) ===
UVICORN_LOOP=asyncio
