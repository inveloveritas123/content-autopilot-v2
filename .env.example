# Database
DB_PASSWORD=change_me_to_something_secure

# LLM APIs (mindestens EINES muss gesetzt sein)
# Option A: Direkte API-Keys
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Option B: Requesty / LiteLLM Proxy (ersetzt direkte Keys)
# LITELLM_BASE_URL=https://router.requesty.ai/v1
# LITELLM_API_KEY=your_requesty_api_key
# Wenn LiteLLM aktiv: GEMINI_API_KEY und ANTHROPIC_API_KEY auf "not-needed-using-litellm" setzen

# Nextcloud
NEXTCLOUD_URL=https://cloudtest.zukunftsbund.de
NEXTCLOUD_USER=robert
NEXTCLOUD_PASSWORD=your_app_password

# App
APP_PORT=8501
MCP_PORT=8080
DEFAULT_TENANT_KEY=change_me_to_random_string

# Optional: VoiceScriptor Telegram Bot
VOICESCRIPTOR_BOT_TOKEN=
