# ============================================================
# content-autopilot-v2 — Umgebungsvariablen
# Kopieren: cp .env.example .env  dann Secrets eintragen
# ============================================================

# === Datenbank ===
DB_PASSWORD=changeme                    # PostgreSQL-Passwort für User 'autopilot'
DATABASE_URL=postgresql+asyncpg://autopilot:${DB_PASSWORD}@host.docker.internal:5432/content_autopilot_v2
SYNC_DATABASE_URL=postgresql://autopilot:${DB_PASSWORD}@host.docker.internal:5432/content_autopilot_v2

# === Redis ===
REDIS_URL=redis://redis-v2:6379/1       # Intern im Docker-Netz

# === LLM-Provider (mindestens einen ausfüllen) ===
GEMINI_API_KEY=                         # Google Gemini Direct API (optional wenn LiteLLM aktiv)
ANTHROPIC_API_KEY=                      # Anthropic Claude Direct API (optional wenn LiteLLM aktiv)
LITELLM_BASE_URL=                       # LiteLLM Proxy oder Requesty.ai Router-URL
LITELLM_API_KEY=                        # API-Key für LiteLLM / Requesty.ai
REQUESTY_API_KEY=                       # Direkter Requesty.ai Key (alternativ zu LITELLM_API_KEY)

# === Nextcloud (Brand Voice + Prompts) ===
NEXTCLOUD_URL=https://nc.example.com    # Nextcloud-Instanz
NEXTCLOUD_USER=service-user             # Nextcloud-Benutzername
NEXTCLOUD_PASSWORD=app-password-here    # Nextcloud App-Passwort (nicht Login-PW)

# === Storage-Pfade (Nextcloud) ===
BRAND_VOICE_NC_BASE_PATH=/content-autopilot/v2/Kunde/
PROMPT_NC_BASE_PATH=/zukunftsbund/projekte/content-autopilot/datensammlung/prompts-skills/

# === Tenant ===
DEFAULT_TENANT_KEY=cap-tenant-changeme  # API-Key für den Default-Tenant (X-API-Key Header)

# === YouTube Cookies (Issue #159) ===
# Pfad zur youtube_cookies.txt — Standard ist v2-Verzeichnis.
# Migration von v1: cp /opt/content-autopilot/data/youtube_cookies.txt /opt/content-autopilot-v2/data/youtube_cookies.txt
YT_COOKIES_PATH=/opt/content-autopilot-v2/data/youtube_cookies.txt

# === Ports ===
APP_PORT=8601                           # Frontend + API Port (nginx)
MCP_PORT=8180                           # MCP-Server Port (extern)

# === App ===
APP_ENV=production                      # dev | staging | production

# === content-truth (Source of Truth fuer Prompts, Rules, Schemas) ===
# Verzeichnis content-truth/ wird als Bind-Mount read-only in Container eingebunden
# CONTENT_TRUTH_BASE_PATH=/app/content-truth
# PROMPT_STORAGE_BACKEND=localfs

# === MCP-Server (OAuth / Bearer) ===
MCP_CLIENT_ID=content-autopilot         # OAuth 2.0 Client-ID für claude.ai Connector
MCP_CLIENT_SECRET=                      # OAuth 2.0 Client-Secret (optional)
MCP_BEARER_TOKEN=                       # Bearer Token für MCP-Zugriff

# === Error-Tracking (optional) ===
SENTRY_DSN=                             # Sentry DSN — leer lassen für disabled

# === Pipeline-Throttle (#156) ===
MAX_CALLS_PER_TENANT_PER_HOUR=200      # Max LLM-Calls pro Tenant und Stunde (Defense-in-Depth)
MAX_CALLS_GLOBAL_PER_HOUR=1000         # Max LLM-Calls global pro Stunde (alle Tenants)

# === Telegram (optional, Phase 3) ===
TELEGRAM_BOT_TOKEN=                     # Telegram Bot-Token
TELEGRAM_WEBHOOK_SECRET=               # Telegram Webhook Secret
TELEGRAM_BOT_USERNAME=content_autopilot_bot
TELEGRAM_ADMIN_CHAT_ID=<set_me>        # Erforderlich für 50%-Cost-Cap-Alert — deine Telegram Chat-ID (z.B. via @userinfobot)

# === Intern (normalerweise nicht ändern) ===
UVICORN_LOOP=asyncio

# === Container Images: Build-Quelle ===
# STANDARD (GitHub-Deploy): beide Zeilen LEER/auskommentiert lassen.
#   -> Images werden lokal aus den Dockerfiles gebaut, KEINE Registry noetig.
# OPTIONAL: vorgebaute Images aus einer Registry ziehen — IMAGE_PREFIX setzen, z.B.:
#   GHCR : IMAGE_PREFIX=ghcr.io/inveloveritas123/content-autopilot-v2
# IMAGE_PREFIX=
# IMAGE_TAG=main                  # Image-Tag bei Registry-Pull (Standard lokal: 'local')

# === Nextcloud als Docker-Service (optional, profile: nextcloud) ===
# Aktivierung: docker compose --profile nextcloud up -d
# Default-Setup laeuft eigenstaendig parallel zur CAv2-Stack auf NEXTCLOUD_PORT.
NEXTCLOUD_ADMIN_USER=admin              # Admin-Account fuer Nextcloud-WebUI
NEXTCLOUD_DB_NAME=nextcloud             # Postgres-DB-Name fuer Nextcloud (Host-Postgres)
NEXTCLOUD_DB_USER=nextcloud             # Postgres-User fuer Nextcloud
NEXTCLOUD_DB_PASSWORD=                  # PFLICHT wenn profile aktiv: Postgres-PW fuer Nextcloud-DB
NEXTCLOUD_PORT=8602                     # Externer Port fuer Nextcloud-WebUI
NEXTCLOUD_HOST=localhost:8602           # OVERWRITEHOST — Hostname:Port fuer URL-Generierung
NEXTCLOUD_PROTOCOL=http                 # http | https (OVERWRITEPROTOCOL)
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 nextcloud-web    # Space-separierte Domain-Liste
NEXTCLOUD_CONFIG_DIR=/var/lib/nextcloud-config                  # Host-Pfad fuer config-Volume
NEXTCLOUD_DATA_VOLUME=/var/lib/nextcloud-data                   # Host-Pfad fuer data-Volume
# Hinweis: NEXTCLOUD_PASSWORD oben ist auch Admin-PW fuer den Container-Service.

# === E2E-Tests (Playwright Smoke + Browser-Use Explore) ===
# Nur fuer lokale E2E-Runs noetig. CI setzt sie selbst.
E2E_BASE_URL=http://localhost:8601          # Wohin Tests sich verbinden
E2E_API_KEY=ci-test-tenant-key              # X-API-Key fuer Test-Tenant
BROWSER_USE_MAX_STEPS=30                    # Hard-Limit pro Browser-Use-Scenario
BROWSER_USE_LLM_MODEL=claude-sonnet-4-6     # LLM-Backend fuer Browser-Use
BROWSER_USE_HEADLESS=true                   # false fuer Debugging mit sichtbarem Browser
