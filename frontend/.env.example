# Frontend Umgebungsvariablen (Vite)
# Kopieren: cp frontend/.env.example frontend/.env.local

# Dev-only: Standard-Tenant-Key fuer lokale Entwicklung.
# Wird NUR im Dev-Build genutzt (import.meta.env.DEV === true).
# Im Prod-Build ersetzt Vite DEV durch `false` — dieser Wert landet NIE im Bundle.
VITE_DEFAULT_TENANT_KEY=cap-tenant-changeme

# Optionaler Tenant-Switcher (Issue #88): JSON-Array mit {label, key}-Eintraegen.
# Nur setzen wenn ihr mehrere Tenants schnell durchschalten wollt (Operator/Dev-Kontext).
# KEINE echten Keys in .env.example committen — Platzhalter nutzen!
# Beispiel:
# VITE_TENANT_LIST=[{"label":"Standard","key":"PLACEHOLDER_STANDARD"},{"label":"Eric Spielhaus","key":"PLACEHOLDER_ERIC"},{"label":"Test","key":"PLACEHOLDER_TEST"}]
# Im .env.local (gitignored) echte Keys eintragen.
